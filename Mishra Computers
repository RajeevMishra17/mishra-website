}

.card img {
    width: 100%;
    border-radius: 10px;
}

/* Form */
.form-section {
    text-align: center;
    padding: 30px;
    background: #111827;
}

form input, form select {
    display: block;
    margin: 10px auto;
    padding: 12px;
    width: 300px;
    border-radius: 5px;
    border: none;
}

/* Button */
button {
    background: green;
    color: white;
    padding: 12px;
    border: none;
    cursor: pointer;
}

/* Payment */
#paymentSection {
    display: none;
    text-align: center;
    padding: 40px;
}

.payment-box {
    background: white;
    color: black;
    width: 320px;
    margin: auto;
    padding: 20px;
    border-radius: 10px;
}

footer {
