}

.card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
    margin: 15px;
    padding: 20px;
    width: 230px;
    border-radius: 15px;
    text-align: center;
    transition: 0.3s;
}

.card:hover {
