}

/* Navbar */
nav {
    background: linear-gradient(orange, white, green);
    padding: 10px;
    text-align: center;
    color: black;
}

/* Hero */
.hero {
    text-align: center;
    padding: 50px;
    background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
